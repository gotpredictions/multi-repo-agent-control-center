{
  "name": "multi-repo-agent-control-center",
  "displayName": "Multi-Repo Agent Control Center",
  "description": "Local dashboard for coordinating coding-agent sessions across multiple repos.",
  "version": "0.0.10",
  "publisher": "local-dev",
  "private": true,
  "repository": {
    "type": "git",
    "url": "local"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.5.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "bin": {
    "control-center-mcp": "./out/mcpServer.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "multiRepoAgentControlCenter.openDashboard",
        "title": "Agent Control Center: Open Dashboard"
      },
      {
        "command": "multiRepoAgentControlCenter.restartRunner",
        "title": "Agent Control Center: Restart Runner"
      },
      {
        "command": "multiRepoAgentControlCenter.resetAllData",
        "title": "Agent Control Center: Reset All Data"
      },
      {
        "command": "multiRepoAgentControlCenter.copyMcpRegistrationCommand",
        "title": "Agent Control Center: Copy MCP Registration Command"
      },
      {
        "command": "multiRepoAgentControlCenter.createMcpJson",
        "title": "Agent Control Center: Create .mcp.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Agent Control Center",
        "description": "Get the dashboard and the MCP server both running.",
        "steps": [
          {
            "id": "openDashboard",
            "title": "Open the dashboard",
            "description": "See what's tracked and populate it — no repo list ships with this extension.",
            "media": { "markdown": "walkthrough/open-dashboard.md" },
            "completionEvents": ["onCommand:multiRepoAgentControlCenter.openDashboard"]
          },
          {
            "id": "registerMcp",
            "title": "Register the MCP server",
            "description": "Let a Claude Code session dispatch to repos and resolve escalations directly.",
            "media": { "markdown": "walkthrough/register-mcp.md" }
          },
          {
            "id": "readDocs",
            "title": "Read the rest",
            "description": "Dispatches, escalations, and findings are three different things — worth knowing before you use any of them.",
            "media": { "markdown": "walkthrough/read-docs.md" }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package -o control-center.vsix"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
