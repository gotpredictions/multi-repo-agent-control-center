{
  "name": "multi-repo-agent-control-center",
  "displayName": "Multi-Repo Agent Control Center",
  "description": "Local dashboard for coordinating coding-agent sessions across multiple repos.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.5.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "bin": {
    "control-center-mcp": "./out/mcpServer.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "multiRepoAgentControlCenter.openDashboard",
        "title": "Agent Control Center: Open Dashboard"
      },
      {
        "command": "multiRepoAgentControlCenter.restartRunner",
        "title": "Agent Control Center: Restart Runner"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
